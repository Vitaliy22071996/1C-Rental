Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка выполняется только при фактической смене категории модели.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Категория КАК Категория
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтараяКатегория = Выборка.Категория;
	КонецЕсли;
	
	Если СтараяКатегория = Категория Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Значения.Характеристика КАК Характеристика,
		|	Значения.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияТехническихХарактеристикМоделей КАК Значения
		|ГДЕ
		|	Значения.МодельОборудования = &МодельОборудования";
	
	Запрос.УстановитьПараметр("МодельОборудования", Ссылка);
	
	СохраненныеХарактеристики = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Характеристики.Характеристика КАК Характеристика
		|ИЗ
		|	Справочник.КатегорииНоменклатуры.Характеристики КАК Характеристики
		|ГДЕ
		|	Характеристики.Ссылка = &Категория";
	
	Запрос.УстановитьПараметр("Категория", Категория);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	РазрешенныеХарактеристики = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		РазрешенныеХарактеристики.Вставить(Выборка.Характеристика, Истина);
		
	КонецЦикла;
	
	// Сохраненные значения не удаляются автоматически при смене категории.
	// Если новая категория их не поддерживает, запись модели блокируется.
	СписокОшибок = Новый Массив;
	
	Для Каждого ЭлементХарактеристики Из СохраненныеХарактеристики Цикл
		
		Если РазрешенныеХарактеристики.Получить(ЭлементХарактеристики.Характеристика) = Неопределено Тогда
			
			СписокОшибок.Добавить(СтрШаблон("Характеристика ""%1"" со значением ""%2"" не поддерживается новой категорией ""%3"".",
					ЭлементХарактеристики.Характеристика,
					ЭлементХарактеристики.Значение,
					Категория));
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокОшибок.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(СписокОшибок, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры