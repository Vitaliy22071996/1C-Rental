Процедура ЗаписатьЗначенияХарактеристикМодели(МодельОборудования, ЗначенияХарактеристик) Экспорт
	
	Если МодельОборудования.Категория.ВидНоменклатуры <> Перечисления.ВидыНоменклатуры.МодельОборудования Тогда
		ВызватьИсключение "Технические характеристики можно задавать только для моделей оборудования.";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Характеристики.Характеристика КАК Характеристика,
		|	Характеристики.Обязательная КАК Обязательная
		|ИЗ
		|	Справочник.КатегорииНоменклатуры.Характеристики КАК Характеристики
		|ГДЕ
		|	Характеристики.Ссылка = &КатегорияНоменклатуры";
	
	Запрос.УстановитьПараметр("КатегорияНоменклатуры", МодельОборудования.Категория);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	РазрешенныеХарактеристики = Новый Соответствие;
	ОбязательныеХарактеристики = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		РазрешенныеХарактеристики.Вставить(Выборка.Характеристика, Выборка.Обязательная);
		
		Если Выборка.Обязательная Тогда
			ОбязательныеХарактеристики.Вставить(Выборка.Характеристика, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	СписокОшибок = Новый Массив;
	ПолученныеХарактеристики = Новый Соответствие;
	
	Для Каждого ЭлементХарактеристики Из ЗначенияХарактеристик Цикл
		
		ПризнакОбязательности = РазрешенныеХарактеристики.Получить(ЭлементХарактеристики.Характеристика);
		
		Если ПризнакОбязательности = Неопределено Тогда
			СписокОшибок.Добавить(СтрШаблон("Характеристика ""%1"" не разрешена для категории ""%2"".",
					ЭлементХарактеристики.Характеристика,
					МодельОборудования.Категория));
			
		ИначеЕсли ПризнакОбязательности Тогда
			
			// Для числовых и булевых характеристик 0 и Ложь являются
			// допустимыми значениями, поэтому их заполненность определяется
			// наличием соответствующей строки в наборе.
			ТипЗначенияХарактеристики = ТипЗнч(ЭлементХарактеристики.Значение);
			
			Если ТипЗначенияХарактеристики = Тип("Строка")
				ИЛИ ТипЗначенияХарактеристики = Тип("Дата") Тогда
				Если НЕ ЗначениеЗаполнено(ЭлементХарактеристики.Значение) Тогда
					СписокОшибок.Добавить(СтрШаблон("Обязательная характеристика ""%1"" не заполнена.",
							ЭлементХарактеристики.Характеристика));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ПолученныеХарактеристики.Получить(
			ЭлементХарактеристики.Характеристика) <> Неопределено Тогда
			СписокОшибок.Добавить(СтрШаблон("Характеристика ""%1"" указана более одного раза.",
					ЭлементХарактеристики.Характеристика));
		Иначе
			ПолученныеХарактеристики.Вставить(ЭлементХарактеристики.Характеристика,Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОбязательнаяХарактеристика Из ОбязательныеХарактеристики Цикл
		
		Если ПолученныеХарактеристики.Получить(ОбязательнаяХарактеристика.Ключ) = Неопределено Тогда
			СписокОшибок.Добавить(
				СтрШаблон("Обязательная характеристика ""%1"" отсутствует для категории ""%2"".",
					ОбязательнаяХарактеристика.Ключ,
					МодельОборудования.Категория));
		КонецЕсли;
	КонецЦикла;
	
	Если СписокОшибок.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(СписокОшибок, Символы.ПС);
	КонецЕсли;
	
	// Переданный набор является полным актуальным набором характеристик модели.
	// Отбор по модели позволяет заменить только ее записи, не затрагивая
	// характеристики других моделей оборудования.
	НаборЗаписей = РегистрыСведений.ЗначенияТехническихХарактеристикМоделей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.МодельОборудования.Установить(МодельОборудования);
	
	Для Каждого ЭлементХарактеристики Из ЗначенияХарактеристик Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.МодельОборудования = МодельОборудования;
		НоваяЗапись.Характеристика = ЭлементХарактеристики.Характеристика;
		НоваяЗапись.Значение = ЭлементХарактеристики.Значение;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры


Функция НайтиМоделиПоХарактеристикам(УсловияПоиска) Экспорт
	
	Если УсловияПоиска.Количество() = 0 Тогда
		
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("МодельОборудования", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		
		Возврат Результат;
		
	КонецЕсли;
	
	// Модель соответствует условиям поиска только тогда, когда количество
	// совпавших значений равно общему количеству переданных условий.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Условия.Характеристика КАК Характеристика,
		|	Условия.Значение КАК Значение
		|ПОМЕСТИТЬ Условия
		|ИЗ
		|	&УсловияПоиска КАК Условия;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаписиЗначений.МодельОборудования КАК МодельОборудования
		|ИЗ
		|	Условия КАК Условия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|			РегистрСведений.ЗначенияТехническихХарактеристикМоделей КАК ЗаписиЗначений
		|		ПО Условия.Характеристика = ЗаписиЗначений.Характеристика
		|			И Условия.Значение = ЗаписиЗначений.Значение
		|СГРУППИРОВАТЬ ПО
		|	ЗаписиЗначений.МодельОборудования
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) = &КоличествоУсловий";
	
	Запрос.УстановитьПараметр("УсловияПоиска", УсловияПоиска);
	Запрос.УстановитьПараметр("КоличествоУсловий", УсловияПоиска.Количество());
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции